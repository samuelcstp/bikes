	<parameter name="REPORT_ROOT_DIR" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT
    l.id AS id,
    c.nome AS cliente,
    c.cpf AS cpf,
    b.codigo AS bicicleta,
    l.data_retirada AS dataRetirada,
    l.data_prevista_devolucao AS dataPrevistaDevolucao,
    l.data_devolucao AS dataDevolucao,
    l.status AS status,
    l.valor AS valor
FROM locacoes l
INNER JOIN clientes c ON l.cliente_id = c.id
INNER JOIN bicicletas b ON l.bicicleta_id = b.id
ORDER BY l.id DESC]]></query>
